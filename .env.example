# Copy this file to .env and fill in what you use. Both values are optional.

# Optional: use another form service instead of the built-in FormSubmit (free) one.
# The first message sent through FormSubmit triggers a one-time activation email to the site inbox.
# If sending fails, the form opens the visitor's email app with the message already written.
PUBLIC_FORM_ENDPOINT=

# Real-time GitHub contributions: URL of your own worker (see workers/github-contributions.js).
# Without it, the site uses a free public service that caches GitHub for up to ~1 hour.
PUBLIC_GITHUB_CONTRIB_URL=

# AI assistant: address of the Cloudflare Worker in workers/agent (the default points at the deployed one).
PUBLIC_AGENT_URL=

# Google Search Console: the code from the "HTML tag" verification method (the content="..." part only).
PUBLIC_GOOGLE_VERIFICATION=
