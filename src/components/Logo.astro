---
import { site } from '../data/site';
import { langOf, link } from '../i18n';
interface Props { full?: boolean }
const { full = false } = Astro.props;
const home = link(langOf(Astro.url), '/');
---
{full ? (
  <a href={home} class="logo logo-full" aria-label={site.fullName}>
    <span class="logo-art" aria-hidden="true"></span>
  </a>
) : (
  <a href={home} class="logo" aria-label={site.name}>
    <span class="logo-mark" aria-hidden="true"></span>
    <span class="logo-word">{site.name}</span>
  </a>
)}
