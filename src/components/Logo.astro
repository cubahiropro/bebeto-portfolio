---
import { site } from '../data/site';
import { langOf, link } from '../i18n';
interface Props { full?: boolean }
const { full = false } = Astro.props;
const home = link(langOf(Astro.url), '/');
---
{full ? (
  <a href={home} class="logo logo-full" aria-label={site.name}>
    <img class="lt" src="/brand/logo-light.png" alt={site.fullName} width="819" height="770" />
    <img class="dk" src="/brand/logo-dark.png" alt="" width="755" height="712" />
  </a>
) : (
  <a href={home} class="logo" aria-label={site.name}>
    <span class="logo-mark">
      <img class="lt" src="/brand/mark-light.png" alt="" width="316" height="240" />
      <img class="dk" src="/brand/mark-dark.png" alt="" width="324" height="240" />
    </span>
    <span class="logo-word">{site.name}</span>
  </a>
)}
