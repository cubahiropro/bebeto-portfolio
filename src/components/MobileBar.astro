---
// Phone-only quick-contact bar: one thumb tap to WhatsApp, call or email. It slides up after the first screen
// and tucks away on the contact page and over the footer, so it never covers content.
import { site } from '../data/site';
import { langOf, t, barePath } from '../i18n';
const lang = langOf(Astro.url);
const onContact = barePath(Astro.url.pathname) === '/contact';
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t(lang, 'contact.waText'))}`;
---
{!onContact && (
  <nav class="mbar" id="mbar" aria-label={t(lang, 'bar.label')}>
    <a class="mbar-main" href={wa} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12 0 12 12 0 0 0 1.6 17.9L0 24l6.3-1.6A12 12 0 0 0 24 12a11.8 11.8 0 0 0-3.5-8.5ZM12 21.9a9.9 9.9 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.9 9.9 0 1 1 12 21.9Zm5.4-7.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1l-1 1.2c-.2.2-.4.2-.7.1a8 8 0 0 1-4-3.5c-.3-.5.3-.5.9-1.6.1-.2.1-.4 0-.5l-.9-2.1c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.3 3.3 0 0 0-1 2.4 5.7 5.7 0 0 0 1.2 3 13 13 0 0 0 5 4.4c1.8.7 2.5.8 3.4.7a2.9 2.9 0 0 0 1.9-1.3 2.3 2.3 0 0 0 .2-1.3c0-.1-.3-.2-.6-.4Z"/></svg>
      <span>{t(lang, 'bar.whatsapp')}</span>
    </a>
    <a href={`tel:${site.phone.replace(/\s/g, '')}`} aria-label={t(lang, 'bar.call')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
    </a>
    <a href={`mailto:${site.email}`} aria-label={t(lang, 'bar.email')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
    </a>
  </nav>
)}
<script>
  const bar = document.getElementById('mbar');
  if (bar) {
    let nearFooter = false;
    const footer = document.querySelector('.site-footer');
    if (footer && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { nearFooter = e.isIntersecting; update(); }, { rootMargin: '0px 0px 120px 0px' }).observe(footer);
    }
    const update = () => bar.classList.toggle('show', scrollY > 420 && !nearFooter);
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
