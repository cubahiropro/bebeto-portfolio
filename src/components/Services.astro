---
import { getServices } from '../i18n/data';
import { langOf } from '../i18n';
interface Props { only?: number[] }
const { only } = Astro.props;
const all = getServices(langOf(Astro.url));
const services = only ? only.map((i) => all[i]) : all;
---
<div class="services-grid">
  {services.map((s, i) => (
    <div class="service">
      <span class="num">{String(i + 1).padStart(2, '0')}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.icon}></svg>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </div>
  ))}
</div>
